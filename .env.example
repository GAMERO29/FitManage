# Copie este archivo como .env (nunca se sube al repositorio: está en .gitignore) y cambie los valores.
# Para generar claves:  openssl rand -hex 32
POSTGRES_PASSWORD=cambie-esta-clave
JWT_CLAVE=cambie-esta-clave-de-firma
DJANGO_SECRET_KEY=cambie-esta-clave-de-django

# Observabilidad (Guía 13). Prometheus usa este token para leer /metrics; sin él, /metrics no existe.
FITMANAGE_METRICAS_TOKEN=cambie-este-token
# Solo con el perfil observabilidad: manda las trazas a Jaeger. Vacío, las trazas no salen.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Proporción de peticiones nuevas que se trazan (ADR N.° 13).
OTEL_TRACES_SAMPLER_ARG=0.1
GRAFANA_CLAVE=cambie-esta-clave
