# Variables que necesita FitManage para arrancar (Guía 16). Sin valores reales: en Render están en
# Environment del servicio; en el laboratorio las pone despliegue_reproducible.sh.
DATABASE_URL=postgresql://USUARIO@HOST:PUERTO/BASE   # en Render, la Internal Database URL
DJANGO_SECRET_KEY=                                    # 32 bytes aleatorios; nunca en el repositorio
JWT_CLAVE=                                            # 32 bytes aleatorios; distinta de la anterior
FITMANAGE_VERSION=                                    # el commit; la imagen la trae en su entorno
FITMANAGE_TELEMETRIA=0                                # 1 en producción (ADR N.° 13)
FITMANAGE_ADMIN_NOMBRE=                               # primer administrador (preparar_gimnasio)
FITMANAGE_ADMIN_CORREO=
FITMANAGE_ADMIN_CLAVE=
