{
  "info": {
    "_postman_id": "dbdd20bc-6cc1-5b07-8303-39361d0f540b",
    "name": "FitManage · API v1 (contrato)",
    "description": "Pruebas del contrato docs/api/openapi.yaml (Guía 6). Por ahora corren contra el mock de Prism generado desde el contrato: `npx @stoplight/prism-cli mock docs/api/openapi.yaml`. Cuando existan los controladores, se cambia `baseUrl` y las mismas pruebas validan la implementación (Guía 7).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4010"
    },
    {
      "key": "tokenAcceso",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Iniciar sesión (sin JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y entrega un token Bearer', () => {",
              "  pm.response.to.have.status(200);",
              "  const b = pm.response.json();",
              "  pm.expect(b.tipo).to.eql('Bearer');",
              "  pm.expect(b.expiraEn).to.eql(900);",
              "  pm.collectionVariables.set('tokenAcceso', b.tokenAcceso);",
              "});",
              "pm.test('La respuesta no devuelve la contraseña', () => pm.expect(pm.response.text()).to.not.include('contrasena'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"laura@gimnasio-demo.co\",\n  \"contrasena\": \"demo2026\"\n}"
        }
      }
    },
    {
      "name": "2. Consultar estado sin token → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 cuando falta el JWT', () => pm.response.to.have.status(401));",
              "pm.test('Error en formato problem+json', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json().codigo).to.eql('NO_AUTENTICADO');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/estados/CC/1090123456",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "estados",
            "CC",
            "1090123456"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "3. Consultar estado con token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con el estado público', () => {",
              "  pm.response.to.have.status(200);",
              "  const b = pm.response.json();",
              "  pm.expect(b.estado).to.be.oneOf(['ACTIVO', 'VENCIDO', 'SIN_MEMBRESIA']);",
              "  pm.expect(b.documentoEnmascarado).to.match(/\\*{4,}\\d{4}$/);",
              "});",
              "pm.test('No expone teléfono ni documento completo', () => {",
              "  const t = pm.response.text();",
              "  pm.expect(t).to.not.include('telefono');",
              "  pm.expect(t).to.not.include('1090123456');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAcceso}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/estados/CC/1090123456",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "estados",
            "CC",
            "1090123456"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "4. Registrar pago",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y Location', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.has('Location')).to.be.true;",
              "});",
              "pm.test('El servidor calcula inicio, vencimiento y valor', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.include.keys('inicia', 'vence', 'valor');",
              "  pm.expect(b.estado).to.eql('VIGENTE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
