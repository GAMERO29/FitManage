{
  "uid": "fitmanage-api",
  "title": "FitManage · API",
  "tags": [
    "fitmanage",
    "guia-13"
  ],
  "timezone": "America/Bogota",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Peticiones por segundo",
      "description": "Todas las rutas de la API, sin /salud ni /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latencia p95 · consulta de estado",
      "description": "Naranja: alarma de ingeniería (300 ms, ADR N.° 08). Rojo: QA-01 incumplido (2 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/api/v1/estados/{tipoDocumento}/{numeroDocumento}\"}[$__rate_interval])))",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errores 5xx",
      "description": "Proporción de respuestas 5xx en la ventana del tablero. El SLO (ADR N.° 14) se mide abajo, en 14 días.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alertas activas",
      "description": "Reglas de observabilidad/prometheus/slo.yml disparadas. Solo con el Prometheus de compose; en Grafana Cloud las alertas se crean en Alerting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasa de peticiones por código de respuesta",
      "description": "Peticiones por segundo, apiladas por código HTTP.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia de la consulta de estado",
      "description": "GET /api/v1/estados/{tipoDocumento}/{numeroDocumento}. Umbrales: 300 ms (aviso) y 2 s (QA-01).",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/api/v1/estados/{tipoDocumento}/{numeroDocumento}\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/api/v1/estados/{tipoDocumento}/{numeroDocumento}\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Porcentaje de errores 5xx",
      "description": "Proporción de respuestas 5xx sobre el total, en ventanas de 1 minuto.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consultas de estado por resultado",
      "description": "ACTIVO, VENCIDO, SIN_MEMBRESIA o NO_ENCONTRADO. Ningún documento: la métrica solo cuenta resultados.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "sum by (resultado) (rate(fitmanage_consultas_estado_total[$__rate_interval]))",
          "legendFormat": "{{resultado}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "SLO del recorrido de recepción (ADR N.° 14) · ventana de 14 días",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Disponibilidad · SLO 99,5 %",
      "description": "Peticiones del recorrido de recepción (sesión y consulta de estado) que no terminaron en 5xx en los últimos 14 días.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\",http_response_status_code=~\"5..\"}[14d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\"}[14d])))",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Presupuesto de error restante",
      "description": "Qué parte del 0,5 % permitido queda. En 0 % o menos, se congelan las funciones nuevas (política del ADR N.° 14).",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "1 - (((sum(increase(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\",http_response_status_code=~\"5..\"}[14d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\"}[14d]))) / 0.005)",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Consultas en menos de 500 ms · SLO 99 %",
      "description": "SLI de latencia: proporción de consultas respondidas en menos de 500 ms en 14 días.",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "expr": "sum(increase(http_server_request_duration_seconds_bucket{http_route=\"/api/v1/estados/{tipoDocumento}/{numeroDocumento}\",le=\"0.5\"}[14d])) / sum(increase(http_server_request_duration_seconds_count{http_route=\"/api/v1/estados/{tipoDocumento}/{numeroDocumento}\"}[14d]))",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Tasa de consumo del presupuesto",
      "description": "1 = se gasta justo el presupuesto en 14 días. Líneas: 6,72 (alerta rápida, ventana de 1 h) y 2,8 (alerta lenta, ventana de 6 h).",
      "datasource": {
        "type": "prometheus",
        "uid": "${fuente}"
      },
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.8
              },
              {
                "color": "red",
                "value": 6.72
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "legendFormat": "1 h",
          "expr": "((sum(rate(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\",http_response_status_code=~\"5..\"}[1h])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\"}[1h]))) / 0.005"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${fuente}"
          },
          "legendFormat": "6 h",
          "expr": "((sum(rate(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\",http_response_status_code=~\"5..\"}[6h])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route=~\"/api/v1/estados/\\\\{tipoDocumento\\\\}/\\\\{numeroDocumento\\\\}|/api/v1/auth/token|/api/v1/auth/renovacion\"}[6h]))) / 0.005"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "fuente",
        "label": "Fuente de datos",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {}
      }
